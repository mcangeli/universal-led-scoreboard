#!/bin/sh
# Root-owned, argument-free restart entrypoint for the dashboard.
set -eu
[ "$#" -eq 0 ] || exit 2
# Schedule in systemd's own cgroup so restarting uls-web cannot kill this job.
/usr/bin/systemd-run --quiet --collect --unit=uls-dashboard-restart --on-active=2s /usr/local/libexec/uls-restart-worker
