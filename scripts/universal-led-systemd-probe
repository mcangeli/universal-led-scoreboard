#!/usr/bin/env python3
"""Harmless systemd lifecycle probe. Never invokes NetworkManager.

The worker sleeps briefly so its running state can be observed. It never
reads recovery state, changes network settings, or touches Wi-Fi profiles.
"""
from __future__ import annotations
import argparse
import time

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument('--seconds',type=int,default=8)
    args=parser.parse_args()
    if not 1 <= args.seconds <= 20:
        parser.error('seconds must be between 1 and 20')
    time.sleep(args.seconds)
    return 0

if __name__=='__main__':
    raise SystemExit(main())
