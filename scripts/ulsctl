#!/usr/bin/env bash
set -Eeuo pipefail
usage() { echo "Usage: ulsctl {status|start|stop|restart|logs|health} [web|matrix|all] | ulsctl update"; }
action="${1:-status}"
if [[ "$action" == update ]]; then
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  exec /opt/uls/app/scripts/uls-update
fi
target="${2:-all}"
case "$target" in
  web) units=(uls-web.service) ;;
  matrix) units=(uls-matrix.service) ;;
  all) units=(uls-web.service uls-matrix.service) ;;
  *) usage >&2; exit 2 ;;
esac
case "$action" in
  status) sudo systemctl status --no-pager "${units[@]}" ;;
  start|stop|restart) sudo systemctl "$action" "${units[@]}" ;;
  logs) args=(); for unit in "${units[@]}"; do args+=(-u "$unit"); done; sudo journalctl "${args[@]}" -n 80 --no-pager ;;
  health)
    sudo systemctl is-active "${units[@]}"
    if [[ "$target" != matrix ]]; then curl --fail --silent --output /dev/null http://127.0.0.1:8080/ && echo "Web endpoint OK"; fi
    if [[ "$target" != web ]]; then test -s /run/uls/live-frame.ppm && echo "Frame available"; fi
    ;;
  *) usage >&2; exit 2 ;;
esac
