#!/usr/bin/env bash
set -Eeuo pipefail
usage() { echo "Usage: ulsctl {status|start|stop|restart|logs|health} [web|matrix|all] | ulsctl update"; }
action="${1:-status}"
if [[ "$action" == update ]]; then
  [[ $# -eq 1 ]] || { usage >&2; exit 2; }
  exec bash /opt/uls/app/scripts/uls-update
fi
target="${2:-all}"
case "$target" in
  web) units=(uls-web.service) ;;
  matrix) units=(uls-matrix.service) ;;
  all) units=(uls-web.service); if systemctl list-unit-files uls-matrix.service --no-legend 2>/dev/null | grep -q uls-matrix.service; then units+=(uls-matrix.service); fi ;;
  *) usage >&2; exit 2 ;;
esac
case "$action" in
  status) sudo systemctl status --no-pager "${units[@]}" ;;
  start|stop|restart) sudo systemctl "$action" "${units[@]}" ;;
  logs) args=(); for unit in "${units[@]}"; do args+=(-u "$unit"); done; sudo journalctl "${args[@]}" -n 80 --no-pager ;;
  health)
    matrix_installed=0
    if systemctl list-unit-files uls-matrix.service --no-legend 2>/dev/null | grep -q uls-matrix.service; then matrix_installed=1; fi
    matrix_enabled=yes
    if (( matrix_installed )) && [[ -f /etc/uls/matrix.json ]]; then
      matrix_enabled=$(cd /opt/uls/app && /opt/uls/venv/bin/python -c 'from universal_led.matrix_settings import load_matrix_settings; print("yes" if load_matrix_settings("/etc/uls/matrix.json")["enabled"] else "no")')
    fi
    if [[ "$target" != matrix ]]; then
      sudo systemctl is-active --quiet uls-web.service || { echo "Web service inactive" >&2; exit 1; }
      echo "Web service active"
      curl --fail --silent --output /dev/null --max-time 3 http://127.0.0.1:8080/health || { echo "Web endpoint unavailable" >&2; exit 1; }
      echo "Web endpoint OK"
    fi
    if [[ "$target" != web ]] && (( matrix_installed )); then
      if [[ "$matrix_enabled" == no ]]; then
        if systemctl is-active --quiet uls-matrix.service; then
          echo "Matrix is running despite disabled configuration; apply saved settings" >&2
          exit 1
        fi
        echo "Physical matrix intentionally disabled (healthy)"
      else
        sudo systemctl is-active --quiet uls-matrix.service || { echo "Matrix service inactive" >&2; exit 1; }
        echo "Matrix service active"
        frame=/run/uls/live-frame.ppm
        test -s "$frame" || { echo "Frame missing or empty" >&2; exit 1; }
        age=$(( $(date +%s) - $(stat -c %Y "$frame") ))
        if (( age < 0 || age > 15 )); then echo "Frame stale ($age seconds old)" >&2; exit 1; fi
        echo "Frame available and fresh ($age seconds old)"
      fi
    fi
    ;;
  *) usage >&2; exit 2 ;;
esac
