#!/usr/bin/env python3
"""Privileged, narrowly scoped update branch request writer."""
import os
import re
import sys
from pathlib import Path

if os.geteuid() != 0 or len(sys.argv) != 1:
    raise SystemExit(2)
branch = sys.stdin.read(200).strip()
if not re.fullmatch(r"[A-Za-z0-9._/-]{1,160}", branch) or ".." in branch or branch.startswith("/") or branch.endswith("/"):
    raise SystemExit("Invalid branch name")
target = Path("/var/lib/uls/update/target-branch")
if not target.parent.is_dir():
    raise SystemExit("Update directory unavailable")
temporary = target.with_name(".target-branch.tmp")
with temporary.open("w", encoding="ascii") as stream:
    os.chmod(temporary, 0o600)
    stream.write(branch + "\n")
os.replace(temporary, target)
print("Branch request accepted")
