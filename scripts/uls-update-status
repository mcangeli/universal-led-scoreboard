#!/usr/bin/env bash
set -Eeuo pipefail
[[ $# -eq 0 ]] || exit 2
APP=/opt/uls/app
[[ -d "$APP/.git" ]] || { echo '{"error":"Installation missing"}'; exit 1; }
cd "$APP"
owner=$(stat -c %U "$APP")
[[ "$owner" != root ]] || exit 1
installed=$(runuser -u "$owner" -- git rev-parse HEAD)
branch=$(runuser -u "$owner" -- git branch --show-current)
[[ -n "$branch" ]] || { echo '{"error":"Detached checkout"}'; exit 1; }
# Read-only network check; never modify the installed Git checkout.
remote=$(runuser -u "$owner" -- git ls-remote --exit-code origin "refs/heads/$branch" | awk 'NR==1{print $1}')
[[ "$remote" =~ ^[a-f0-9]{40}$ ]] || { echo '{"error":"Remote branch unavailable"}'; exit 1; }
printf '{"branch":"%s","installed":"%s","remote":"%s","update_available":%s}\n' "$branch" "$installed" "$remote" "$([[ "$installed" == "$remote" ]] && echo false || echo true)"
