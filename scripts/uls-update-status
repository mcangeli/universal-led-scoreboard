#!/usr/bin/env bash
set -Eeuo pipefail
[[ $# -eq 0 ]] || exit 2
APP=/opt/uls/app
[[ -d "$APP/.git" ]] || { echo '{"error":"Installation missing"}'; exit 1; }
cd "$APP"
owner=$(stat -c %U "$APP")
[[ "$owner" != root ]] || exit 1
installed=$(runuser -u "$owner" -- git rev-parse HEAD)
branch=$(runuser -u "$owner" -- git branch --show-current)
[[ -n "$branch" ]] || { echo '{"error":"Detached checkout"}'; exit 1; }
# Read-only remote branch discovery, with no checkout modifications.
refs=$(runuser -u "$owner" -- git ls-remote --heads origin)
printf '%s\n' "$refs" | /usr/bin/python3 -c '
import json, re, sys
branch, installed = sys.argv[1:3]
heads = {}
for line in sys.stdin:
    fields = line.strip().split()
    if len(fields) != 2 or not fields[1].startswith("refs/heads/"):
        continue
    name = fields[1][len("refs/heads/"):]
    if re.fullmatch(r"[A-Za-z0-9._/-]{1,160}", name) and re.fullmatch(r"[0-9a-f]{40}", fields[0]):
        heads[name] = fields[0]
if branch not in heads:
    raise SystemExit("Installed branch missing from remote")
print(json.dumps({"branch": branch, "installed": installed, "remote": heads[branch],
                  "update_available": installed != heads[branch],
                  "branches": sorted(heads)}))
' "$branch" "$installed"
